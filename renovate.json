{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":prHourlyLimit4",
    ":semanticCommits",
    ":prConcurrentLimit10",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "description": "The go directive is a minimum Go version for library consumers: never auto-merge it, and type it feat so it releases as a minor version and appears in release notes",
      "automerge": false,
      "semanticCommitType": "feat",
      "semanticCommitScope": "go"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "description": "Keep the whole OpenTelemetry family (otel, contrib, proto, auto) in one PR so versions never mix",
      "groupName": "otel",
      "groupSlug": "otel",
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "go.opentelemetry.io/**"
      ],
      "semanticCommitScope": "otel-deps",
      "semanticCommitType": "{{#if isPatch}}fix{{else}}feat{{/if}}"
    },
    {
      "description": "Google client stack moves together (api, grpc, genproto, protobuf, cloud.google.com, googleapis) to avoid overlapping single-module PRs",
      "groupName": "google-cloud",
      "groupSlug": "google-cloud",
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "google.golang.org/**",
        "cloud.google.com/go/**",
        "github.com/googleapis/**"
      ]
    }
  ],
  "labels": [
    "dependencies"
  ],
  "ignorePresets": [":ignoreModulesAndTests"],
  "separateMinorPatch": true
}
